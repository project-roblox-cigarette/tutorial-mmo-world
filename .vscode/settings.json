{
  // エディタ共通設定
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // TypeScript
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Luau
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },

  // roblox-ts
  "robloxLsp.diagnostics.globals": ["game", "workspace", "script"],

  // Luau LSP
  "luau-lsp.plugin.enabled": true,
  "luau-lsp.sourcemap.enabled": true,
  "luau-lsp.sourcemap.rojoProjectFile": "apps/game/default.project.json",
  "luau-lsp.ignoreGlobs": ["**/include/**", "**/node_modules/**"],

  // Selene - include フォルダを除外
  "selene.ignoreGlobs": ["**/include/**", "**/node_modules/**"],

  // ファイル関連付け
  "files.associations": {
    "*.luau": "luau"
  },

  // 自動インポート
  "typescript.preferences.importModuleSpecifier": "relative",

  // ESLint
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // include フォルダ内の Lua ファイルの診断を無効化
  "files.exclude": {
    "**/include/*.lua": false
  },

  // Selene を Lua ファイルで無効化（include フォルダは自動生成ファイル）
  "selene.run": "onSave"
}
