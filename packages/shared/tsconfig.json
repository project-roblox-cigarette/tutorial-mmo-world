{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out",
    "declaration": false,
    "typeRoots": ["node_modules/@rbxts"],
    "types": ["types", "compiler-types"],
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "removeComments": true
  },
  "include": ["src"],
  "exclude": ["out", "node_modules"]
}
