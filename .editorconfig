# EditorConfig - チーム全体で統一されたエディタ設定
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.{luau,lua}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

