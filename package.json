{
  "name": "tutorial-mmo-world",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:game": "pnpm --filter @game/main dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:lua": "stylua .",
    "format:lua:check": "stylua --check .",
    "prepare": "husky",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@johnnymorganz/stylua-bin": "^2.3.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "rojo": "1.0.3-rojo7.6.1"
  }
}
