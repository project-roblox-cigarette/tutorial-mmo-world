{
  "name": "tutorial-mmo-world",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:game": "pnpm --filter @game/main dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:lua": "stylua .",
    "format:lua:check": "stylua --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@johnnymorganz/stylua-bin": "^2.3.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "rojo": "1.0.3-rojo7.6.1",
    "typescript-eslint": "^8.18.0"
  }
}
