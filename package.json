{
  "name": "tutorial-mmo-world",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "node scripts/check-runtime.cjs && pnpm -r build",
    "dev:game": "node scripts/check-runtime.cjs && pnpm --filter @game/main dev",
    "lint": "node scripts/check-runtime.cjs && eslint .",
    "lint:fix": "node scripts/check-runtime.cjs && eslint . --fix",
    "format": "node scripts/check-runtime.cjs && prettier --write .",
    "format:check": "node scripts/check-runtime.cjs && prettier --check .",
    "format:lua": "node scripts/check-runtime.cjs && stylua .",
    "format:lua:check": "node scripts/check-runtime.cjs && stylua --check .",
    "prepare": "node scripts/check-runtime.cjs && husky",
    "deps:audit": "node scripts/check-runtime.cjs && node scripts/audit-dependencies-offline.mjs",
    "deps:install": "node scripts/check-runtime.cjs && pnpm install --frozen-lockfile --ignore-scripts && pnpm run deps:audit",
    "test:security": "node scripts/check-runtime.cjs && node --test scripts/check-runtime.test.cjs",
    "preinstall": "node scripts/check-runtime.cjs",
    "security:runtime": "node scripts/check-runtime.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "typescript-eslint": "8.72.0",
    "typescript": "5.5.3",
    "cross-env": "10.1.0"
  },
  "engines": {
    "node": "22.23.4",
    "pnpm": "12.14.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "download"
    }
  }
}
