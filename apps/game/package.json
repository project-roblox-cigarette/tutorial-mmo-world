{
  "name": "@game/main",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/check-runtime.cjs && concurrently \"pnpm watch\" \"pnpm watch:rojo\"",
    "build": "node ../../scripts/check-runtime.cjs && NODE_OPTIONS='--max-old-space-size=4096' rbxtsc --type=game",
    "watch": "node ../../scripts/check-runtime.cjs && NODE_OPTIONS='--max-old-space-size=4096' nodemon",
    "watch:rojo": "node ../../scripts/check-runtime.cjs && nodemon --config nodemon-rojo.json",
    "test": "node ../../scripts/check-runtime.cjs && node ../../scripts/run-testez.cjs"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/testez": "0.4.2-ts.0",
    "@rbxts/types": "^1.0.896",
    "chokidar-cli": "^3.0.0",
    "nodemon": "^3.1.11",
    "roblox-ts": "^3.0.0"
  },
  "dependencies": {
    "@packages/shared": "workspace:*",
    "@rbxts/services": "^1.6.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
