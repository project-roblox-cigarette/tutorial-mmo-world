{
  "name": "@game/main",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm watch\" \"pnpm watch:rojo\"",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 rbxtsc --type=game",
    "watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 rbxtsc --watch --usePolling --type=game",
    "test": "echo 'Tests run in Roblox Studio with TestEZ'",
    "watch:rojo": "rojo serve default.project.json"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/testez": "0.4.2-ts.0",
    "@rbxts/types": "^1.0.896",
    "roblox-ts": "^3.0.0"
  },
  "dependencies": {
    "@packages/shared": "workspace:*",
    "@rbxts/services": "^1.6.0"
  }
}
