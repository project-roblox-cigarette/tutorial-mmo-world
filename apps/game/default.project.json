{
  "name": "tutorial-mmo-world",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "Shared": {
        "$path": "out/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "out/server"
      },
      "Tests": {
        "$path": "out/tests"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "out/client"
        }
      }
    }
  }
}
